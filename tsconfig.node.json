{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* Modules */
    "moduleResolution": "bundler",
    "types": ["node"],

    /* Emit */
    "noEmit": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Language and Environment */
    "target": "esnext",
    "lib": ["esnext"]
  }
}
